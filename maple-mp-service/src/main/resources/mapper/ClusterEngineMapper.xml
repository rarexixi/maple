                    </if>
                    <if test="condition.clusterIdNotIn != null and condition.clusterIdNotIn.size() > 0">
                        AND MT.`cluster_id` NOT IN
                        <foreach collection="condition.clusterIdNotIn" item="it" open="(" close=")" separator=",">#{it}</foreach>
                    </if>
                    <if test="condition.clusterIdIsNotEmpty != null and condition.clusterIdIsNotEmpty == true">
                        AND MT.`cluster_id` IS NOT NULL AND `cluster_id` != ''
                    </if>
                    <if test="condition.clusterIdIsEmpty != null and condition.clusterIdIsEmpty == true">
                        AND (MT.`cluster_id` IS NULL OR MT.`cluster_id` = '')
                    </if>
                    <if test="condition.clusterIdStartWith != null and condition.clusterIdStartWith != ''">
                        AND MT.`cluster_id` LIKE concat(#{condition.clusterIdStartWith}, '%')
                    </if>
                    <if test="condition.clusterIdEndWith != null and condition.clusterIdEndWith != ''">
