    </delete>

    <!--根据条件更新计算引擎实体不为空的字段-->
    <update id="patchByCondition">
        UPDATE <include refid="tableName"/>
        <set>
            <if test="entity.clusterId != null">
                `cluster_id` = #{entity.clusterId},
            </if>
            <if test="entity.name != null">
                `name` = #{entity.name},
            </if>
            <if test="entity.version != null">
