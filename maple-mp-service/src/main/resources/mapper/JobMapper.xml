    <select id="getById" resultMap="ExtResultMap">
        SELECT
            MT.`id`,
            MT.`job_name`,
            MT.`description`,
            MT.`job_type`,
            MT.`user_group`,
            MT.`owner`,
            MT.`from_app`,
            MT.`engine_id`,
            `T0`.`name` `engine_text`,
            MT.`cluster_id`,
            MT.`cluster_category`,
            MT.`priority`,
            MT.`pri_upgradable`,
            MT.`run_conf`,
            MT.`job_conf`,
            MT.`disabled`,
            MT.`created_by`,
            MT.`updated_by`,
            MT.`created_at`,
            MT.`updated_at`
        FROM
        <include refid="tableName"/> MT
            LEFT JOIN (SELECT `id`, `name` FROM `maple_cluster_engine`) T0 ON MT.engine_id = T0.`id`
        <where>
            MT.`id` = #{id}
        </where>
    </select>

