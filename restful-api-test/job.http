### Flink jar yarn


POST http://localhost:8080/execution/exec?timestamp=0&secret=
Content-Type: application/json

{
  "execFile": "hdfs:///flink/jars/1.17/original-flink-test-1.0-SNAPSHOT.jar",
  "fromApp": "streaming",
  "bizId": "20250520",
  "execName": "flink-nc-wc-test-20250520",
  "jobType": "flink-jar",
  "clusterId": 1,
  "engineId": 3,
  "resourceGroup": {
    "queue": "default"
  },
  "priority": 1,
  "priUpgradable": false,
  "userGroup": 1,
  "runBy": 1,
  "execConf": {
    "execFile": "hdfs:///flink/jars/1.17/original-flink-test-1.0-SNAPSHOT.jar",
    "mainClass": "org.xi.flink.WordCount",
    "args": ""
  },
  "runConf": {
    "jobManagerCores": "1",
    "jobManagerMemory": "1g",
    "parallelism": "2",
    "taskManagerCores": "1",
    "taskManagerMemory": "1g",
    "numberOfTaskSlots": "2",
    "yarnFlinkLib": "hdfs://localhost:9000/flink/dist/1.17",
    "conf": {
      "state.backend": "rocksdb",
      "state.backend.incremental": "true",
      "restart-strategy": "fixeddelay",
      "restart-strategy.fixed-delay.attempts": "15",
      "restart-strategy.fixed-delay.delay": "10s",
      "execution.checkpointing.interval": "10min",
      "execution.checkpointing.timeout": "10min",
      "execution.checkpointing.unaligned": "false"
    }
  }
}

