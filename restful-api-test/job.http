
### Spark

POST http://localhost:8080/execution/exec-now?timestamp=0&secret=
Content-Type: application/json

{
  "fromApp": "schedule",
  "jobId": 1,
  "bizId": 2,
  "execName": "测试执行",
  "clusterId": 2,
  "engineId": 2,
  "priority": 1,
  "priUpgradable": false,
  "userGroup": "schedule-manager",
  "runBy": "xishihao",
  "execConf": {
    "execFile": "hdfs:///spark3/spark-examples_2.12-3.3.2.jar",
    "mainClass": "org.apache.spark.examples.SparkPi",
    "args": [
      "10"
    ]
  },
  "runConf": {
    "namespace": "ns-tjgzvu",
    "queue": "default-offline",
    "driverCores": 1,
    "driverMemory": "4g",
    "numExecutors": 2,
    "executorCores": 2,
    "executorMemory": "8g",
    "driverJavaOptions": "",
    "driverClassPath": "",
    "jars": "",
    "files": "",
    "archives": "",
    "conf": {
      "spark.hadoop.ipc.client.connect.timeout": 3000,
      "spark.hadoop.yarn.client.failover-max-attempts": 2
    }
  }
}

