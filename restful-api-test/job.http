    "execFile": "hdfs:///spark3/spark-examples_2.12-3.3.2.jar",
    "mainClass": "org.apache.spark.examples.SparkPi",
    "args": "1000"
  },
  "runConf": {
    "queue": "default",
    "driverCores": 1,
    "driverMemory": "1g",
    "numExecutors": 1,
    "executorCores": 1,
    "executorMemory": "1g",
    "driverJavaOptions": "",
