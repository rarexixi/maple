### Flink

POST http://localhost:8080/execution/exec?timestamp=0&secret=
Content-Type: application/json

{
  "fromApp": "schedule",
  "jobId": 3,
  "bizId": "201",
  "execName": "test-flink-py",
  "engineId": 4,
  "clusterId": 2,
  "priority": 1,
  "priUpgradable": false,
  "userGroup": "schedule-manager",
  "runBy": "xishihao",
  "clusterAppId": "",
  "execConf": {
    "pyFiles": "/data_query/file/b02f6fe1-575c-4cf4-ab03-df65a3d74e69.py",
    "pyModule": "b02f6fe1-575c-4cf4-ab03-df65a3d74e69",
    "args": [
      ""
    ]
  },
  "runConf": {
    "namespace": "ns-tjgzvu",
    "queue": "default-offline",
    "jobManagerHaEnable": "true",
    "jobManagerReplicas": "2",
    "jobManagerCores": "1",
    "jobManagerMemory": "5",
    "parallelism": "20",
    "taskManagerCores": "1",
    "taskManagerMemory": "10",
    "numberOfTaskSlots": "5",
    "conf": {
      "state.backend": "rocksdb",
      "state.backend.incremental": "true",
      "restart-strategy": "fixeddelay",
      "restart-strategy.fixed-delay.attempts": "15",
      "restart-strategy.fixed-delay.delay": "10s",
      "execution.checkpointing.interval": "10min",
      "execution.checkpointing.timeout": "10min",
      "execution.checkpointing.unaligned": "false"
    }
  }
}

