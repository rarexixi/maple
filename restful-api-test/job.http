  "jobType": "spark3-jar",
  "clusterId": 1,
  "engineId": 1,
  "resourceGroup": {
    "queue": "default"
  },
  "priority": 1,
  "priUpgradable": false,
  "userGroup": 1,
  "runBy": 1,
