{
  "mysql-cdc": [
    {
      "name": "table_name",
      "dataType": "STRING",
      "nullable": false,
      "metadataKey": "table_name",
      "virtual": true,
      "comment": "该行的表的名称"
    },
    {
      "name": "database_name",
      "dataType": "STRING",
      "nullable": false,
      "metadataKey": "database_name",
      "virtual": true,
      "comment": "该行的数据库的名称"
    },
    {
      "name": "op_ts",
      "dataType": "TIMESTAMP_LTZ(3)",
      "nullable": false,
      "metadataKey": "op_ts",
      "virtual": true,
      "comment": "在数据库中进行更改的时间，如果记录是从表快照读取的，则始终为 0"
    },
    {
      "name": "row_kind",
      "dataType": "STRING",
      "nullable": false,
      "metadataKey": "row_kind",
      "virtual": true,
      "comment": "表示 changelog 的行类型 (“+I”表示 INSERT 消息，“-D”表示 DELETE 消息，“-U”表示UPDATE_BEFORE消息，“+U”表示UPDATE_AFTER消息)"
    }
  ],
  "kafka": [
    {
      "name": "topic",
      "dataType": "STRING",
      "nullable": false,
      "metadataKey": "topic",
      "virtual": false,
      "comment": "Kafka 记录的 topic"
    },
    {
      "name": "partition",
      "dataType": "INT",
      "nullable": false,
      "metadataKey": "partition",
      "virtual": true,
      "comment": "Kafka 记录的 Partition ID"
    },
    {
      "name": "headers",
      "dataType": "MAP",
      "nullable": false,
      "metadataKey": "headers",
      "virtual": false,
      "comment": "Kafka 记录的标头，作为原始字节的映射"
    },
    {
      "name": "leader-epoch",
      "dataType": "INT",
      "nullable": true,
      "metadataKey": "leader-epoch",
      "virtual": true,
      "comment": "Kafka 记录的 leader epoch"
    },
    {
      "name": "offset",
      "dataType": "BIGINT",
      "nullable": false,
      "metadataKey": "offset",
      "virtual": true,
      "comment": "分区中 Kafka 记录的偏移量"
    },
    {
      "name": "timestamp",
      "dataType": "TIMESTAMP_LTZ(3)",
      "nullable": false,
      "metadataKey": "timestamp",
      "virtual": false,
      "comment": "Kafka 记录的时间戳"
    },
    {
      "name": "timestamp-type",
      "dataType": "STRING",
      "nullable": false,
      "metadataKey": "timestamp-type",
      "virtual": true,
      "comment": "Kafka 记录的时间戳类型"
    }
  ]
}